<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/field"
    android:fitsSystemWindows="true">

    <!-- الـ Toolbar مع القيود العلوية -->
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_common"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- محتوى الإحصائيات مع القيود الصحيحة والارتفاع 0dp -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- القسم الأول: Score & Hints -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="#8BC34A"
                android:gravity="center"
                android:text="Score &amp; Hints"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="#66000000"
                android:orientation="vertical"
                android:padding="8dp">

                <include
                    android:id="@+id/rowTotalScore"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowTotalHints"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowUsedHints"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowCurrentHints"
                    layout="@layout/item_stat_row" />
            </LinearLayout>

            <!-- القسم الثاني: Logos & Medals -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="#8BC34A"
                android:gravity="center"
                android:text="Logos &amp; Medals"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="#66000000"
                android:orientation="vertical"
                android:padding="8dp">

                <include
                    android:id="@+id/rowTotalLogos"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowCompletedLogos"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowGoldMedals"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowSilverMedals"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowBronzeMedals"
                    layout="@layout/item_stat_row" />
            </LinearLayout>

            <!-- القسم الثالث: Levels -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="#8BC34A"
                android:gravity="center"
                android:text="Levels"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#66000000"
                android:orientation="vertical"
                android:padding="8dp">

                <include
                    android:id="@+id/rowTotalLevels"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowOpenLevels"
                    layout="@layout/item_stat_row" />

                <include
                    android:id="@+id/rowCompletedLevels"
                    layout="@layout/item_stat_row" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>