<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_margin="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#222222"> <!-- يمكنك تغيير اللون ليناسب خلفية العشب لديك -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <!-- 1. نص اسم الدولة أو رقم المستوى في الأعلى -->
            <TextView
                android:id="@+id/tvLevelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPAIN"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 2. صورة القفل: تظهر فقط عندما يكون المستوى مغلقاً وتتوسط العنصر -->
            <ImageView
                android:id="@+id/lock"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/lock"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 3. منطقة العناصر المفتوحة Unlocked Area -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/unlockedArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvLevelName"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- صورة علم الدولة -->
                <ImageView
                    android:id="@+id/ivLevelIcon"
                    android:layout_width="90dp"
                    android:layout_height="55dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- نص الـ Score -->
                <TextView
                    android:id="@+id/tvLevelScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score : 0"
                    android:textColor="#BBBBBB"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toTopOf="@id/logosProgress"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginBottom="2dp"/>

                <!-- نص نسبة الإنجاز للشعارات -->
                <TextView
                    android:id="@+id/tvLevelProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 18"
                    android:textColor="#BBBBBB"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toTopOf="@id/logosProgress"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="2dp"/>

                <!-- شريط التقدم الأفقي -->
                <ProgressBar
                    android:id="@+id/logosProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="2dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>